{
  "include": [
    "."
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/migrations",
    ".git"
  ],
  "venvPath": ".",
  "venv": "venv",
  "reportMissingImports": "warning",
  "reportMissingTypeStubs": false,
  "pythonVersion": "3.13",
  "typeCheckingMode": "basic",
  "useLibraryCodeForTypes": true,
  "strictListInference": false,
  "strictDictionaryInference": false,
  "strictSetInference": false
}
